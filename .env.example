# Copy to .env and fill in real values. Never commit .env.

# ── Deployment ──────────────────────────────────
DOMAIN=localhost

# ── LLM ─────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Vector search (local Docker Qdrant via docker-compose) ──
# docker-compose sets QDRANT_URL=http://qdrant:6333 for retrieval/indexing containers.
# Use http://localhost:6333 when running indexing scripts on the host.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=recipes_full
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Postgres ────────────────────────────────────
POSTGRES_USER=dishify
POSTGRES_PASSWORD=change-me-postgres

# ── Keycloak ────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_BACKEND_SECRET=change-me-backend-secret
KEYCLOAK_PUBLIC_URL=http://localhost:9001

# ── Auth ────────────────────────────────────────
DISABLE_AUTH=true
