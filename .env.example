# Copy to .env and fill in real values. Never commit .env.

# LLM (pick one for the new backend)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Vector search
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Database (user service preferences)
DATABASE_URL=postgresql+psycopg://dishify:dishify@localhost:5432/dishify

# Keycloak
# KEYCLOAK_URL is for backend-to-Keycloak traffic.
# KEYCLOAK_PUBLIC_URL is returned to browser/iOS clients by /auth/config.
KEYCLOAK_URL=http://localhost:9001
KEYCLOAK_PUBLIC_URL=http://localhost:9001
KEYCLOAK_REALM=dishify
KEYCLOAK_CLIENT_ID=dishify-backend
KEYCLOAK_CLIENT_SECRET=

# Backend dev
DISABLE_AUTH=true
