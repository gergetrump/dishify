# Copy to .env and fill in real values. Never commit .env.

# ── Deployment ──────────────────────────────────
DOMAIN=localhost

# ── LLM ─────────────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Vector search ───────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Postgres ────────────────────────────────────
POSTGRES_USER=dishify
POSTGRES_PASSWORD=change-me-postgres

# ── Keycloak ────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_BACKEND_SECRET=change-me-backend-secret
KEYCLOAK_PUBLIC_URL=http://localhost:9001

# ── Auth ────────────────────────────────────────
DISABLE_AUTH=true
