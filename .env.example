# Copy to .env and fill in real values. Never commit .env.

# ── Deployment ──────────────────────────────────
DOMAIN=localhost

# ── LLM ─────────────────────────────────────────
# GEMINI_API_KEY powers the ingest service (voice transcription + image→ingredient
# detection). Put it in .env.secret for docker-compose (env_file).
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Reasoning model for recipe explanations + step augmentation. Fast & cheap beats
# openrouter/free (which is queued and slow). e.g. openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ── Media ingestion (voice + image) ─────────────
# Gemini models used by the ingest service. Override if your key has different access.
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ── Vector search (local Docker Qdrant via docker-compose) ──
# docker-compose overrides QDRANT_URL to http://qdrant:6333 for retrieval/indexing.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=recipes_10000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Postgres ────────────────────────────────────
POSTGRES_USER=dishify
POSTGRES_PASSWORD=change-me-postgres

# ── Keycloak ────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak
KEYCLOAK_BACKEND_SECRET=change-me-backend-secret
KEYCLOAK_PUBLIC_URL=http://localhost:9001

# ── Auth ────────────────────────────────────────
DISABLE_AUTH=true
