{
  "$description": "Single source of truth for Dishify visual design. Edit here first, then sync design/theme.css and ios/Dishify/Assets.xcassets semantic colors.",
  "color": {
    "light": {
      "background": "#f6f3ee",
      "surface": "#ffffff",
      "textPrimary": "#222222",
      "textSecondary": "#6b6560",
      "accent": "#f28c66",
      "primaryAction": "#2b2a25",
      "primaryActionText": "#ffffff",
      "border": "#e4ded7",
      "success": "#2d6a4f",
      "error": "#b42318"
    },
    "dark": {
      "background": "#1a1917",
      "surface": "#262522",
      "textPrimary": "#f6f3ee",
      "textSecondary": "#a8a29e",
      "accent": "#f28c66",
      "primaryAction": "#f6f3ee",
      "primaryActionText": "#2b2a25",
      "border": "#3d3a36",
      "success": "#52b788",
      "error": "#f87171"
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16
  },
  "typography": {
    "title": { "size": 28, "weight": "bold" },
    "headline": { "size": 18, "weight": "semibold" },
    "body": { "size": 16, "weight": "regular" },
    "caption": { "size": 13, "weight": "regular" }
  },
  "elevation": {
    "card": "0 2px 8px rgba(0, 0, 0, 0.08)"
  },
  "layout": {
    "minTapTarget": 44,
    "contentMaxWidth": 720
  }
}
